{
  "name": "@martinloop/mcp",
  "version": "0.1.2",
  "mcpName": "io.github.keesan12/martin-loop",
  "private": false,
  "type": "module",
  "description": "Governed MCP server for AI coding agents with budgets, verifier gates, policy checks, and audit trails.",
  "license": "MIT",
  "author": "Vakeesan Mahalingam and Gobi Shanthan",
  "homepage": "https://martinloop.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keesan12/martin-loop.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/Keesan12/martin-loop/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "martin-loop",
    "ai-agent",
    "claude",
    "codex"
  ],
  "bin": {
    "mcp": "./dist/server.js",
    "martin-loop-mcp": "./dist/server.js"
  },
  "exports": {
    "./server.json": "./server.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/build-package.mjs",
    "prepack": "pnpm build",
    "smoke:pack": "node ./scripts/smoke-package.mjs",
    "smoke:published": "node ./scripts/smoke-published-package.mjs",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@open-policy-agent/opa-wasm": "^1.10.0",
    "@opentelemetry/api-logs": "^0.214.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "ts-morph": "^21.0.0"
  }
}
