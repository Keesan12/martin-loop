{
  "name": "@martin/benchmarks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public deterministic benchmark harness for MartinLoop OSS claims.",
  "scripts": {
    "prebuild": "pnpm --filter @martin/contracts build && pnpm --filter @martin/core build",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "preeval": "pnpm build",
    "eval": "node dist/eval.js --suite under-3-challenge",
    "eval:phase12": "node dist/eval.js --suite under-3-challenge",
    "prereport:ralphy": "pnpm build",
    "report:ralphy": "node dist/eval.js --suite ralphy-engineering-50"
  },
  "dependencies": {
    "@martin/contracts": "workspace:*",
    "@martin/core": "workspace:*"
  }
}
